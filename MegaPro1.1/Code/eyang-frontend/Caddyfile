:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle /ws/* {
        reverse_proxy backend:8000
    }

    handle_path /static/* {
        root * /app/static_cdn/static_root
        file_server
    }

    handle_path /media/* {
        root * /app/media
        file_server
    }

    handle {
        root * /srv
        try_files {path} {path}/ /index.html
        file_server
    }
}
